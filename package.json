{
  "name": "bpharma-lims",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev/dev.cjs",
    "build": "vite build && node scripts/build-server.cjs",
    "build:server": "node scripts/build-server.cjs",
    "start": "node --enable-source-maps dist-server/server.cjs",
    "clean": "rm -rf dist dist-server",
    "lint": "npm run lint:web && npm run lint:server && npm run lint:a11y",
    "lint:web": "tsc -p tsconfig.web.json --noEmit",
    "lint:server": "node scripts/typecheck-server.cjs",
    "lint:a11y": "eslint",
    "check:root": "bash scripts/check-root-clean.sh",
    "seed": "tsx scripts/dev/seed/index.ts",
    "desktop": "npm run build && electron .",
    "fetch:pg": "node desktop/pg-fetch.cjs",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "test": "vitest run",
    "test:controls": "tests/security-controls.sh",
    "test:installer": "node --test \"tests/installer/*.test.cjs\"",
    "test:desktop-embedded": "xvfb-run -a node tests/desktop-embedded.cjs",
    "release:manifest": "node scripts/make-release-manifest.cjs",
    "release:sbom": "node scripts/release/make-sbom.cjs",
    "release:audit": "node scripts/release/audit-gate.cjs",
    "test:e2e": "node tests/e2e/run.cjs",
    "validation:check": "node validation/build/check.cjs"
  },
  "devDependencies": {
    "@fontsource/outfit": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "amqplib": "^2.0.1",
    "autoprefixer": "^10.4.21",
    "axe-core": "4.10.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "docx": "^9.10.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "electron": "^43.8.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "ldapts": "^9.2.0",
    "lucide-react": "^1.44.0",
    "motion": "^12.23.24",
    "node-cron": "4.2.1",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "pino": "10.4.0",
    "playwright": "1.56.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "supertest": "7.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.2.3",
    "vitest": "3.2.7",
    "xlsx": "^0.18.5",
    "zod": "^4.6.1"
  },
  "main": "desktop/main.cjs",
  "description": "B-Pharma LIMS (GxP) desktop application",
  "build": {
    "appId": "com.bpharma.lims",
    "productName": "B-Pharma LIMS",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "extraResources": [
      { "from": "build/pgsql", "to": "pgsql" }
    ],
    "files": [
      "dist/**",
      "dist-server/**",
      "drizzle/**",
      "desktop/**",
      "scripts/release/**",
      "release-manifest.json",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "B-Pharma-LIMS-Setup-${version}.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "npmRebuild": false
  },
  "author": "B-Pharma"
}

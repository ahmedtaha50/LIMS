{
  "//": "Type check of the plain-JavaScript tools (JSDoc types, no build step). Run: bash scripts/typecheck.sh",
  "compilerOptions": {
    "allowJs": true, "checkJs": true, "noEmit": true, "strict": true,
    "target": "es2022", "module": "commonjs", "moduleResolution": "node", "resolveJsonModule": true,
    "types": ["node"], "skipLibCheck": true
  },
  "include": ["lib/*.cjs", "tests/*.cjs"]
}

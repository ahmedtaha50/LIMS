{
 "REPORT": {
  "type": "object",
  "properties": {
   "track": {
    "type": "string"
   },
   "status": {
    "type": "string",
    "enum": [
     "complete",
     "partial",
     "blocked"
    ]
   },
   "done": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "notDone": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "filesChanged": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "testsAdded": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "testEvidence": {
    "type": "string",
    "description": "Exact commands run and their pass/fail totals"
   },
   "decisionsForUser": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "GxP or product judgements implemented as conservative defaults that need human confirmation"
   },
   "needsFromOtherTracks": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "acceptance": {
    "type": "array",
    "description": "The acceptance ledger: one entry per acceptance criterion of the track's gaps, numbered as in the brief. 'met' needs evidence: the test file and a fragment of the test title.",
    "items": {
     "type": "object",
     "properties": {
      "gap": {
       "type": "string"
      },
      "n": {
       "type": "integer",
       "description": "1-based number of the criterion within its gap"
      },
      "status": {
       "type": "string",
       "enum": [
        "met",
        "partly",
        "not-met"
       ]
      },
      "evidence": {
       "type": "string",
       "description": "tests/api/x.test.ts :: fragment of the test title"
      }
     },
     "required": [
      "gap",
      "n",
      "status"
     ]
    }
   }
  },
  "required": [
   "track",
   "status",
   "done",
   "notDone",
   "filesChanged",
   "testsAdded",
   "testEvidence",
   "decisionsForUser",
   "needsFromOtherTracks",
   "acceptance"
  ]
 },
 "GATE": {
  "type": "object",
  "properties": {
   "green": {
    "type": "boolean"
   },
   "commit": {
    "type": "string"
   },
   "checks": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "Each gate with its result"
   },
   "integrationFixes": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "remainingFailures": {
    "type": "array",
    "items": {
     "type": "string"
    }
   }
  },
  "required": [
   "green",
   "commit",
   "checks",
   "integrationFixes",
   "remainingFailures"
  ]
 }
}

{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2023"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true, "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true, "verbatimModuleSyntax": true, "isolatedModules": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true, "types": ["node"],
    "outDir": "dist", "rootDir": "."
  },
  "include": ["server", "tests", "vitest.config.ts"]
}

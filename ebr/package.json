{
  "name": "bpharma-ebr",
  "version": "0.1.0",
  "private": true,
  "description": "Electronic batch record and logbook system (GMP). One web application for tablets and desktops, on the factory server.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/server/main.js",
    "migrate": "tsx server/migrate/cli.ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json && tsc -p tests/e2e/tsconfig.json && eslint client",
    "test": "vitest run",
    "test:routes:update": "UPDATE_ROUTE_TABLE=1 vitest run tests/api/core-routes.test.ts tests/api/permission-matrix.test.ts",
    "test:e2e": "playwright test",
    "create-admin": "tsx server/identity/cli.ts",
    "create-admin:built": "node dist/server/identity/cli.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^3.2.4"
  }
}

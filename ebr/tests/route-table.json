  {
    "method": "GET",
    "path": "/api/signatures/meanings",
    "permission": "session",
    "summary": "The signature meanings the system knows"
  },
  {
    "method": "GET",
    "path": "/api/users",
    "permission": "users.manage",
    "summary": "List the accounts"
  },
  {
    "method": "POST",
    "path": "/api/users",
    "permission": "users.manage",
    "summary": "Create an account (the user changes the first password at sign-in)"
  },
  {
    "method": "PATCH",
    "path": "/api/users/:id",
    "permission": "users.manage",
    "summary": "Change name, roles or status of an account (states the version read)"
  },
  {
    "method": "POST",
    "path": "/api/users/:id/unlock",
    "permission": "users.manage",
    "summary": "Unlock an account locked after failed sign-ins"

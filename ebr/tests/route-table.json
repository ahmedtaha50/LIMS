  },
  {
    "method": "GET",
    "path": "/api/auth/me",
    "permission": "session",
    "summary": "Who is signed in, with the permissions of this session"
  },
  {
    "method": "POST",
    "path": "/api/auth/password",
    "permission": "session",
    "summary": "Change your own password"
  },
  {
    "method": "POST",
    "path": "/api/auth/totp/confirm",
    "permission": "session",
    "summary": "Finish setting up the authenticator app with a code from it"
  },
  {
    "method": "POST",
    "path": "/api/auth/totp/enroll",
    "permission": "session",

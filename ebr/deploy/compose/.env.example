# Copy to .env next to docker-compose.yml and set real values. Never commit the .env file.
EBR_DB_PASSWORD=change-me-database-password
EBR_BOOTSTRAP_ADMIN_USER=admin
EBR_BOOTSTRAP_ADMIN_PASSWORD=change-me-first-admin-password
# 1 behind TLS (nginx); 0 only for a test installation over plain http
EBR_COOKIE_SECURE=1
EBR_PORT=4100

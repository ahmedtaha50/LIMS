# B-Pharma LIMS: environment variables read at start-up (validated by src/server/config.ts).
# Copy to .env.local for development. In production the desktop shell sets everything itself;
# a server install sets these in the service definition. Never commit real values.
#
# A malformed value stops the server with one readable message that names the variable.

# --- Mode and network -------------------------------------------------------------------------------------
# production (the default when unset) | development | test. Development has to be asked for.
NODE_ENV=production
# Address to listen on. Loopback unless LIMS_BIND_LAN=1.
HOST=127.0.0.1
PORT=3000
# Serve other computers on the LAN. Requires a TLS certificate and key; plain http from another computer is refused.
# LIMS_BIND_LAN=1
# LIMS_TLS_CERT_FILE=/etc/lims/tls/server.crt
# LIMS_TLS_KEY_FILE=/etc/lims/tls/server.key
# Number of reverse proxies in front of the server whose X-Forwarded-For may be trusted. 0 = none (the default).
# TRUST_PROXY=0
# Directory with the built frontend (npm run build writes dist/).
# DIST_DIR=dist

# --- Secrets ----------------------------------------------------------------------------------------------
# Signs session tokens. Required in production: random, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: AI assistance (Gemini). Leave empty to keep it off.
# GEMINI_API_KEY=
# Optional: RabbitMQ broker for background jobs (amqp:// or amqps://). Without it jobs run in the database queue.
# RABBITMQ_URL=amqp://localhost

# --- Database (PostgreSQL) --------------------------------------------------------------------------------
# All four are required in production.
SQL_HOST=127.0.0.1
SQL_USER=lims
SQL_PASSWORD=
SQL_DB_NAME=lims

# --- Logging and limits -----------------------------------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info
# Directory for encrypted backups (default: ./backups).
# BACKUP_DIR=backups
# A second location for backups (another disk or a network share). Every backup is copied there and the copy is compared by checksum.
# BACKUP_MIRROR_DIR=
# The key of the scheduled (unattended) backups, at least 12 characters; or a file that holds it. The desktop shell keeps it in the
# operating system credential store. Without it a scheduled backup is recorded as failed. Whoever restores needs it: file it with QA/IT.
# BACKUP_PASSPHRASE=
# BACKUP_PASSPHRASE_FILE=
# Scheduled backups kept: daily/weekly/monthly (default 7/4/12). A backup an Administrator makes by hand is never deleted automatically.
# BACKUP_RETENTION=7/4/12
# When the nightly backup runs on a new installation: five cron fields, server local time (default 0 2 * * *).
# BACKUP_CRON=0 2 * * *
# Folder for generated documents such as Certificate of Analysis PDFs, kept 30 days (default: "artifacts" next to the backups folder).
# ARTIFACT_DIR=
# Folder of the raw-data files attached to samples, one file per content named by its SHA-256; part of every backup (default: "blobs" next to the backups folder).
# BLOB_DIR=
# Folder of the batch archive bundles (read-only folders with a SHA-256 manifest; default: "archives" next to the backups folder). Copy it to the backup mirror: it is not part of the database backup.
# ARCHIVE_DIR=
# Largest raw-data file accepted, in bytes (default 52428800, 50 MiB).
# ATTACHMENT_MAX_BYTES=52428800
# Instrument data capture: the folder agent that watches the folders of approved capture profiles (on, or off to disable it), and its poll interval in ms (default 5000).
# INSTRUMENT_AGENT=on
# INSTRUMENT_POLL_MS=5000
# Background jobs: pg (default, the database queue) or amqp (RabbitMQ announces new jobs so they start at once; needs RABBITMQ_URL).
# QUEUE_DRIVER=pg
# Requests per minute per client address (a backstop; the desktop build serves every user from 127.0.0.1) ...
# RATE_LIMIT_IP_PER_MINUTE=3000
# ... and per signed-in session.
# RATE_LIMIT_USER_PER_MINUTE=600
# Failed sign-ins per 15 minutes, per address and per e-mail address (successful sign-ins are not counted).
# RATE_LIMIT_AUTH_IP_FAILURES=20
# RATE_LIMIT_AUTH_EMAIL_FAILURES=10

# --- Outbound events (webhooks, e-mail, file drop; roadmap M23) --------------------------------------------
# The only networks a webhook may call: comma separated addresses and CIDR ranges of your LAN. Empty = no webhook can be created.
# Link-local and cloud metadata addresses (169.254.0.0/16, fe80::/10), multicast and reserved ranges are refused whatever this says.
# EVENTS_WEBHOOK_ALLOWLIST=10.0.0.0/8,192.168.0.0/16
# Folder under which file subscriptions drop one JSON file per event (for an ERP). Unset = no file subscription.
# EVENTS_DROP_DIR=
# SMTP relay for e-mail subscriptions. Unset = no e-mail subscription. Security: starttls (default, port 587), tls (465) or none (25,
# trusted network only; credentials are then refused).
# EVENTS_SMTP_HOST=
# EVENTS_SMTP_PORT=587
# EVENTS_SMTP_SECURITY=starttls
# EVENTS_SMTP_FROM=lims@example.com
# EVENTS_SMTP_USER=
# EVENTS_SMTP_PASSWORD=
